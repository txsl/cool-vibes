# Copy to .env and fill in your own values:  cp .env.example .env
# .env is gitignored - it holds this deployment's settings, which must not be
# committed. The server reads it at startup (see load_env_file in
# daikin_server.py), so it works under launchd, which never sources a shell
# profile.

# BLE address / CoreBluetooth UUID of the BRC1H controller.
# Find it with:  python3 brc1h_spike.py --scan
DAIKIN_ADDRESS=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
